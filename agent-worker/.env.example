# ── Database ──────────────────────────────────────────────────────
# Standard PostgreSQL URL (no asyncpg prefix — Prisma uses its own driver)
# Local:
#   DATABASE_URL=postgresql://ideaos:ideaos_dev_pw@localhost:5432/ideaos
# Supabase:
#   DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://ideaos:ideaos_dev_pw@localhost:5432/ideaos

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Tavily (AI web search for research agents) ───────────────────
# Get a free API key at https://app.tavily.com/
TAVILY_API_KEY=

# ── LangSmith (agent observability) ───────────────────────────────
# Sign up at https://smith.langchain.com/ and create an API key.
# Traces every LLM call, tool invocation, and graph run for debugging.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=LaunchPadAI
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Application ──────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Worker ────────────────────────────────────────────────────────
QUEUE_NAME=ideaos:phase_jobs_v2
# How long to block on BLPOP before looping (seconds)
BLPOP_TIMEOUT=5
