# ── Backend API URL ───────────────────────────────────────────────
# Leave empty for local dev (uses Next.js rewrites to proxy /api/* -> localhost:8000)
NEXT_PUBLIC_API_URL=

# For docker-compose or separate backend:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# For production (Railway):
# NEXT_PUBLIC_API_URL=https://your-backend-service.up.railway.app

# For production (AWS / custom domain):
# NEXT_PUBLIC_API_URL=https://api.launchpadai.com
