# ── Database ──────────────────────────────────────────────────────
# Local development:
#   DATABASE_URL=postgresql+asyncpg://ideaos:ideaos_dev_pw@localhost:5432/ideaos
#   DATABASE_URL_SYNC=postgresql://ideaos:ideaos_dev_pw@localhost:5432/ideaos
#
# Supabase (production — supports pgvector):
#   Get connection string from Supabase Dashboard > Settings > Database > Connection string > URI
#   DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#   DATABASE_URL_SYNC=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
DATABASE_URL=postgresql+asyncpg://ideaos:ideaos_dev_pw@localhost:5432/ideaos
DATABASE_URL_SYNC=postgresql://ideaos:ideaos_dev_pw@localhost:5432/ideaos

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ────────────────────────────────────────────
# IMPORTANT: Generate a strong random key for production
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Tavily (AI web search for research agents) ───────────────────
# Get a free API key at https://app.tavily.com/
TAVILY_API_KEY=

# ── LangSmith (agent observability) ───────────────────────────────
# Sign up at https://smith.langchain.com/ and create an API key.
# Traces every LLM call, tool invocation, and crew run for debugging.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=LaunchPadAI
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Razorpay (payments) ──────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_TEAM=

# ── Email / SMTP ─────────────────────────────────────────────────
# Any SMTP provider works (Gmail, SendGrid, AWS SES, Resend, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@launchpadai.com
SMTP_FROM_NAME=LaunchPadAI
SMTP_USE_TLS=true

EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# ── Application ──────────────────────────────────────────────────
APP_ENV=development
APP_NAME=LaunchPadAI
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Frontend URL used for links in emails
FRONTEND_URL=http://localhost:3000

# ── Server (used by start.sh) ────────────────────────────────────
PORT=8000
WORKERS=1
LOG_LEVEL=info
