# ── Database ──────────────────────────────────────────────────────
# Async driver for FastAPI/SQLAlchemy
DATABASE_URL=postgresql+asyncpg://ideaos:ideaos_dev_pw@localhost:5432/ideaos
# Sync driver for Alembic migrations
DATABASE_URL_SYNC=postgresql://ideaos:ideaos_dev_pw@localhost:5432/ideaos

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ────────────────────────────────────────────
# IMPORTANT: Generate a strong random key for production
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Razorpay (payments) ──────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_TEAM=

# ── Application ──────────────────────────────────────────────────
APP_ENV=development
APP_NAME=LaunchPadAI
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ── Server (used by start.sh) ────────────────────────────────────
PORT=8000
WORKERS=1
LOG_LEVEL=info
